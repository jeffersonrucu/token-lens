# Copie para .env e ajuste. O .env não vai para o repositório.

# Pasta onde o Claude Code grava as sessões (padrão: $CLAUDE_CONFIG_DIR/projects ou ~/.claude/projects).
# No Windows, ~ é C:\Users\<você>. No WSL, é a home do Linux: se o Claude Code roda no Windows,
# aponte para /mnt/c/Users/<você>/.claude/projects.
# CLAUDE_PROJECTS_DIR=

# Sessões do Codex (padrão: $CODEX_HOME/sessions ou ~/.codex/sessions) e do pi
# (padrão: $PI_CODING_AGENT_DIR/sessions ou ~/.pi/agent/sessions). O Orca roda esses mesmos
# CLIs, então as sessões abertas por ele já caem nessas pastas.
# CODEX_SESSIONS_DIR=
# PI_SESSIONS_DIR=

# Intervalo (ms) para reler as pastas quando o sistema não avisa das mudanças, o caso de um caminho
# \\wsl.localhost ou de um drive de rede. Nessas pastas o app já relê sozinho; defina para forçar nas outras.
# MONITOR_POLL_MS=3000

# Cache dos totais de uso (padrão: ~/.tokenlens/usage-cache.json).
# MONITOR_CACHE_PATH=

# Banco de usuários do monitor (padrão: ~/.tokenlens/app.db).
# MONITOR_DB_PATH=

# API local.
# PORT=47831
# LOG_LEVEL=info

# --- Hub (servidor de compartilhamento). Deixe tudo comentado numa instalação local. ---
# Como publicar e configurar: docs/hub.md
# MODE=hub
# HOST=0.0.0.0
# URL pública do hub, usada nos links de share e nos e-mails.
# HUB_PUBLIC_URL=https://tokenlens.exemplo.com.br
# Só estes domínios podem criar conta e entrar (separados por vírgula). Vazio = qualquer e-mail.
# HUB_ALLOWED_EMAIL_DOMAINS=exemplo.com.br
# false bloqueia links públicos: todo share passa a exigir a lista de e-mails.
# HUB_ALLOW_PUBLIC_SHARES=true
# Envio de e-mail pelo Resend. Sem a chave, o hub só registra o e-mail no log (desenvolvimento).
# RESEND_API_KEY=
# HUB_EMAIL_FROM=TokenLens <tokenlens@exemplo.com.br>
